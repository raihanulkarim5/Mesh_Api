<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mesh.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the core Identity model (IdentityUser<TKey>) - not tied to EF Core,
         so this project stays persistence-ignorant otherwise. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="10.0.0" />
  </ItemGroup>

</Project>
